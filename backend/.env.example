# Database
DATABASE_URL=sqlite:///./autonomous_soc.db

# App
APP_NAME=Autonomous SOC
APP_ENV=development
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security (change before any real deployment)
SECRET_KEY=change-me-before-deployment

# ML
CONTAMINATION_RATE=0.08
RISK_THRESHOLD=40
