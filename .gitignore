# ==========================================
# CyberNova Project - GitHub .gitignore
# ==========================================

# ---------- Node.js & Frontend ----------
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
.cache/
.parcel-cache/
.eslintcache

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------- Python & Backend ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# SQLite Database & Storage (Local runtime state)
*.db
*.db-shm
*.db-wal
*.db-journal
*.db.corrupt
*.sqlite
*.sqlite3
backend/*.db
cybernova.db

# ML Artifacts & Temp Files
.pytest_cache/
.coverage
htmlcov/
.nox/
.hypothesis/

# ---------- Editors & Operating Systems ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE Files
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ai agent .dot files
.claude
